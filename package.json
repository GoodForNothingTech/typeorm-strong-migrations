{
    "name": "typeorm-strong-migrations",
    "version": "0.1.0",
    "description": "Catch unsafe TypeORM migrations in development",
    "keywords": [
        "typeorm",
        "migrations",
        "postgres",
        "postgresql",
        "mysql",
        "mariadb",
        "zero-downtime",
        "ddl",
        "schema",
        "safety",
        "strong-migrations"
    ],
    "homepage": "https://github.com/goodfornothing/typeorm-strong-migrations#readme",
    "bugs": {
        "url": "https://github.com/goodfornothing/typeorm-strong-migrations/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goodfornothing/typeorm-strong-migrations.git"
    },
    "author": {
        "name": "Micah Bowie",
        "email": "micah@goodfornothing.tech"
    },
    "license": "MIT",
    "type": "commonjs",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./testing": {
            "import": {
                "types": "./dist/esm/testing/index.d.mts",
                "default": "./dist/esm/testing/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/testing/index.d.ts",
                "default": "./dist/cjs/testing/index.js"
            }
        },
        "./register": {
            "require": "./dist/cjs/register.js",
            "import": "./dist/esm/register.mjs"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "bin": {
        "typeorm-strong-migrations": "./dist/cjs/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run build:cjs && npm run build:esm && npm run build:fixup",
        "build:cjs": "tsc -p tsconfig.build.json",
        "build:esm": "tsc -p tsconfig.build.esm.json && node scripts/rename-esm.mjs",
        "build:fixup": "node scripts/write-esm-package-json.mjs",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:ci": "prettier --check .",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:integration": "vitest run --project integration",
        "test:all": "vitest run",
        "coverage": "vitest run --coverage",
        "corpus:extract": "tsx scripts/extract-corpus.ts",
        "db:up": "docker compose up -d --wait",
        "db:down": "docker compose down -v",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {},
    "peerDependencies": {
        "typeorm": "^0.3.0 || ^1.0.0-dev"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@tsconfig/node20": "20.1.9",
        "@types/node": "20.19.43",
        "@vitest/coverage-v8": "4.1.10",
        "eslint": "10.6.0",
        "mysql2": "3.22.6",
        "pg": "8.22.0",
        "prettier": "3.9.4",
        "reflect-metadata": "0.2.2",
        "tsx": "4.20.6",
        "typeorm": "1.1.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.63.0",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": ">=20"
    },
    "sideEffects": [
        "./dist/cjs/register.js",
        "./dist/esm/register.mjs"
    ]
}
