{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist/cjs",
        "module": "commonjs",
        "moduleResolution": "node10",
        "verbatimModuleSyntax": false,
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "test", "scripts"]
}
