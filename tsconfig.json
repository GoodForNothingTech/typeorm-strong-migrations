{
    "extends": "@tsconfig/node20/tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "noEmit": true,
        "declaration": true,
        // Typechecking runs in ESM so `verbatimModuleSyntax` can do its real job:
        // enforcing `import type` for everything from `typeorm`, which is what keeps a
        // single build working across TypeORM 0.3 and 1.x. The build configs override
        // `module` per target and turn it off.
        "module": "esnext",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "useDefineForClassFields": false,
        "strictPropertyInitialization": false,
        "exactOptionalPropertyTypes": false,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src", "test", "scripts", "*.ts", "*.mjs"],
    "exclude": ["node_modules", "dist"]
}
